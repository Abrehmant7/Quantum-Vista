---
const reasons = [
    {
        title: "Strategy before execution",
        desc: "We map business goals, user journeys, and technical constraints before writing code or launching campaigns.",
        tag: "01",
    },
    {
        title: "Built for measurable growth",
        desc: "Every website, app, and marketing system is shaped around clear conversion paths, analytics, and performance signals.",
        tag: "02",
    },
    {
        title: "Design and engineering together",
        desc: "Our work balances polished interfaces with maintainable architecture, fast loading, and practical content workflows.",
        tag: "03",
    },
    {
        title: "Transparent collaboration",
        desc: "You get clear communication, visible progress, and decisions explained in plain language from planning to launch.",
        tag: "04",
    },
];
---

<section class="py-24 bg-gray-900 border-y border-gray-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#4f4f4f24_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f24_1px,transparent_1px)] bg-[size:28px_28px] opacity-30"></div>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-16 items-center">
            <div class="reveal-on-scroll reveal-from-left">
                <p class="text-sm font-bold uppercase tracking-widest text-indigo-400 mb-4">
                    Why Choose Us
                </p>
                <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white mb-6">
                    A partner that thinks beyond the launch date.
                </h2>
                <p class="text-lg text-slate-400 leading-relaxed mb-10">
                    We combine product thinking, technical craft, and growth strategy so your digital presence does more than look impressive. It becomes easier to manage, measure, and scale.
                </p>

                <div class="why-orbit relative mx-auto lg:mx-0 w-72 h-72 sm:w-80 sm:h-80">
                    <div class="absolute inset-0 rounded-full border border-indigo-500/20"></div>
                    <div class="absolute inset-8 rounded-full border border-blue-500/20"></div>
                    <div class="absolute inset-16 rounded-full border border-purple-500/20"></div>
                    <div class="why-orbit-dot absolute top-0 left-1/2 h-5 w-5 -translate-x-1/2 rounded-full bg-indigo-400 shadow-[0_0_22px_rgba(129,140,248,0.9)]"></div>
                    <div class="why-orbit-dot why-orbit-dot-alt absolute bottom-8 right-8 h-4 w-4 rounded-full bg-cyan-400 shadow-[0_0_22px_rgba(34,211,238,0.75)]"></div>
                    <div class="absolute inset-0 flex items-center justify-center">
                        <div class="why-core h-32 w-32 rounded-full bg-gray-950 border border-gray-800 flex items-center justify-center text-center px-5 shadow-2xl">
                            <span class="text-sm font-extrabold uppercase tracking-widest text-indigo-300">
                                Build<br />Measure<br />Scale
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="space-y-5">
                {
                    reasons.map((reason, index) => (
                        <div
                            class="why-row reveal-on-scroll relative overflow-hidden rounded-[1.6rem] border border-gray-800 bg-gray-950/70 p-6 sm:p-7"
                            style={`--reveal-delay: ${index * 120}ms; --tilt: ${index % 2 === 0 ? "-1.2deg" : "1.2deg"};`}
                        >
                            <div class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-blue-400 to-indigo-500"></div>
                            <div class="flex flex-col sm:flex-row sm:items-start gap-5">
                                <div class="why-number shrink-0 h-14 w-14 rounded-2xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-300 font-extrabold">
                                    {reason.tag}
                                </div>
                                <div>
                                    <h3 class="text-2xl font-bold text-white mb-3">
                                        {reason.title}
                                    </h3>
                                    <p class="text-slate-400 leading-relaxed">
                                        {reason.desc}
                                    </p>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .why-orbit {
        animation: why-orbit-breathe 6s ease-in-out infinite;
    }

    .why-orbit::before,
    .why-orbit::after {
        content: "";
        position: absolute;
        inset: -10px;
        border-radius: 9999px;
        background: conic-gradient(from 90deg, transparent, rgba(99, 102, 241, 0.5), transparent 35%);
        animation: why-spin 9s linear infinite;
        opacity: 0.5;
        -webkit-mask: radial-gradient(circle, transparent 62%, #000 63%);
        mask: radial-gradient(circle, transparent 62%, #000 63%);
    }

    .why-orbit::after {
        animation-duration: 14s;
        animation-direction: reverse;
        opacity: 0.35;
    }

    .why-orbit-dot {
        animation: why-dot 7s linear infinite;
        transform-origin: 50% 10rem;
    }

    .why-orbit-dot-alt {
        animation-duration: 10s;
        animation-direction: reverse;
    }

    .why-core {
        animation: why-core-glow 4s ease-in-out infinite;
    }

    .why-row {
        transform: rotate(var(--tilt));
        transition: transform 360ms ease, border-color 300ms ease, background-color 300ms ease;
    }

    .why-row.is-visible {
        transform: rotate(var(--tilt)) translate(0, 0) scale(1);
    }

    .why-row:hover {
        transform: rotate(0deg) translateX(10px);
        border-color: rgba(99, 102, 241, 0.55);
    }

    .why-row::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(115deg, transparent 20%, rgba(255, 255, 255, 0.07) 48%, transparent 70%);
        transform: translateX(-120%);
        transition: transform 800ms ease;
        pointer-events: none;
    }

    .why-row:hover::after {
        transform: translateX(120%);
    }

    .why-row:hover .why-number {
        transform: rotate(-8deg) scale(1.08);
        transition: transform 260ms ease;
    }

    @keyframes why-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @keyframes why-orbit-breathe {
        0%,
        100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.03);
        }
    }

    @keyframes why-dot {
        to {
            rotate: 360deg;
        }
    }

    @keyframes why-core-glow {
        0%,
        100% {
            box-shadow: 0 22px 70px rgba(79, 70, 229, 0.18);
        }
        50% {
            box-shadow: 0 28px 90px rgba(59, 130, 246, 0.28);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .why-orbit,
        .why-orbit::before,
        .why-orbit::after,
        .why-orbit-dot,
        .why-core {
            animation: none;
        }

        .why-row,
        .why-row:hover,
        .why-row.is-visible,
        .why-row:hover::after,
        .why-row:hover .why-number {
            transform: none;
        }
    }
</style>
