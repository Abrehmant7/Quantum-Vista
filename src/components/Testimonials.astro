---
const testimonials = [
  {
    quote: "Quantum Vista delivered a custom platform that completely transformed our operational efficiency. Highly responsive and visionary.",
    name: "Alex Mercer",
    role: "CTO, Vanguard Logistics",
    initials: "AM"
  },
  {
    quote: "Their data-driven digital marketing campaigns increased our organic reach by 200% within the first 3 months. Outstanding results.",
    name: "Sarah Jenkins",
    role: "Marketing Director, Bloom Retail",
    initials: "SJ"
  },
  {
    quote: "Approached Quantum Vista for a complete website overhaul. They guided us step-by-step and the final product is stunning and fast.",
    name: "David Chen",
    role: "Founder, Zenith Hub",
    initials: "DC"
  },
  {
    quote: "Exceptional SEO services. We are now ranking on the first page for all our primary keywords. Keep up the great work!",
    name: "Elena Rodriguez",
    role: "CEO, Horizon Services",
    initials: "ER"
  },
  {
    quote: "They developed our iOS and Android apps seamlessly. The team is communicative, talented, and highly recommended to all.",
    name: "Marcus Thorne",
    role: "Product Manager, FitTech",
    initials: "MT"
  }
];
---

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<section class="py-32 bg-gray-950 relative overflow-hidden border-t border-gray-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        Client <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-amber-500 inline-block">Testimonials</span>
      </h2>
      <p class="mt-4 text-xl text-slate-400 max-w-3xl mx-auto">
        Don't just take our word for it. See what our partners say.
      </p>
    </div>

    <div class="relative group">
      <!-- Arrows -->
      <button id="slider-left" class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 lg:-inset-x-6 z-20 w-12 h-12 bg-gray-800 rounded-full flex items-center justify-center text-white border border-gray-700 shadow-xl hover:bg-gray-700 transition-colors focus:outline-none hidden sm:flex">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      </button>
      
      <button id="slider-right" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 lg:-right-6 z-20 w-12 h-12 bg-gray-800 rounded-full flex items-center justify-center text-white border border-gray-700 shadow-xl hover:bg-gray-700 transition-colors focus:outline-none hidden sm:flex">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </button>

      <!-- Slider Container -->
      <div id="slider-container" class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-8 pt-4 px-2 hide-scrollbar scroll-smooth">
        {testimonials.map((test) => (
          <div class="snap-center shrink-0 w-[90%] sm:w-[50%] lg:w-[33%] rounded-2xl border border-gray-800 bg-gray-900 flex flex-col justify-between p-8 relative overflow-hidden group/card hover:border-yellow-500/50 transition-colors duration-300">
            <!-- Top Accent Line -->
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-yellow-400 to-amber-500"></div>
            
            <div>
              <svg class="w-8 h-8 text-yellow-500/40 mb-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
              <p class="text-slate-300 italic leading-relaxed mb-8">
                "{test.quote}"
              </p>
            </div>
            
            <div class="flex items-center gap-4 mt-auto">
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center font-bold text-white shadow-lg text-lg ring-2 ring-gray-900 border border-gray-700">
                {test.initials}
              </div>
              <div>
                <h4 class="font-bold text-white leading-tight">{test.name}</h4>
                <div class="flex items-center gap-1 mt-1 text-yellow-400 text-xs">
                  <!-- 5 Stars -->
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      
    </div>
  </div>
</section>

<script>
  const container = document.getElementById('slider-container');
  const leftBtn = document.getElementById('slider-left');
  const rightBtn = document.getElementById('slider-right');

  if (container && leftBtn && rightBtn) {
    const scrollAmount = 350; // Approximations for scroll step
    
    leftBtn.addEventListener('click', () => {
      container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });
    
    rightBtn.addEventListener('click', () => {
      container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });
  }
</script>
