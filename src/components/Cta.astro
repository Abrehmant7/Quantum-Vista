---

---

<section class="py-24 relative overflow-hidden bg-indigo-600">
    <div
        class="absolute inset-0 bg-gradient-to-r from-indigo-600 to-purple-600"
    >
    </div>

    <!-- Decorative background elements -->
    <div
        class="absolute top-0 left-0 w-full h-full overflow-hidden opacity-20 pointer-events-none"
    >
        <div
            class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-white blur-3xl"
        >
        </div>
        <div
            class="absolute bottom-0 right-0 w-64 h-64 rounded-full bg-pink-500 blur-3xl"
        >
        </div>
    </div>

    <div
        class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 relative z-10 text-center"
    >
        <h2
            class="text-3xl font-extrabold tracking-tight text-white sm:text-5xl mb-6"
        >
            Ready to Transform Your Digital Presence?
        </h2>
        <p class="text-xl text-indigo-100 mb-10 max-w-2xl mx-auto">
            Join the ranks of successful businesses trusting Quantum Vista to
            accelerate their growth. Let's build something extraordinary
            together.
        </p>
        <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-full bg-white px-8 py-4 text-lg font-bold text-indigo-600 shadow-xl hover:bg-indigo-50 hover:shadow-2xl hover:-translate-y-1 transition-all duration-300"
        >
            Get a Free Consultation
            <svg
                class="ml-2 w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
        </a>
    </div>
</section>
