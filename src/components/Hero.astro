---

---

<section
    class="relative overflow-hidden bg-gray-950 pt-24 pb-24 sm:pt-32 sm:pb-40 lg:pt-40 lg:pb-32"
>
    <!-- Glowing Orbs Background -->
    <div
        class="absolute top-0 left-1/2 -z-10 -translate-x-1/2 transform-gpu blur-3xl sm:top-[-20rem] sm:ml-16 sm:translate-x-0"
        aria-hidden="true"
    >
        <div
            class="aspect-[1097/845] w-[68.5625rem] bg-gradient-to-tr from-[#ff4694] to-[#776fff] opacity-20"
            style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
        >
        </div>
    </div>

    <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
    >
    </div>
    <div
        class="absolute inset-0 -z-10 h-full w-full bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"
    >
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div
            class="grid grid-cols-1 gap-16 lg:grid-cols-2 lg:gap-8 items-center"
        >
            <!-- Left Column: Content -->
            <div class="max-w-2xl text-center lg:text-left">
                <h1
                    class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl"
                >
                    Accelerate Your <span
                        class="bg-gradient-to-r from-indigo-400 to-purple-400 bg-clip-text text-transparent"
                        >Digital Growth</span
                    >
                </h1>
                <p class="mt-6 text-lg leading-8 text-slate-300">
                    Quantum Vista delivers cutting-edge software solutions and
                    data-driven marketing to scale your business. Stay ahead of
                    the curve with our innovative technologies.
                </p>
                <div
                    class="mt-10 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-x-6 gap-y-4"
                >
                    <a
                        href="/services"
                        class="rounded-md bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all w-full sm:w-auto"
                    >
                        Our Services
                    </a>
                    <a
                        href="/contact"
                        class="rounded-md px-6 py-3 text-sm font-semibold text-slate-100 shadow-sm ring-1 ring-inset ring-slate-700 hover:ring-slate-500 hover:bg-slate-800 transition-all w-full sm:w-auto"
                    >
                        Contact Us <span aria-hidden="true">&rarr;</span>
                    </a>
                </div>
            </div>

            <!-- Right Column: Abstract Graphic -->
            <div
                class="relative mx-auto w-full max-w-lg lg:max-w-none flex justify-center perspective-1000"
            >
                <!-- A decorative 3D-ish composition -->
                <div class="relative w-64 h-64 sm:w-80 sm:h-80 group">
                    <!-- Central glowing element -->
                    <div
                        class="absolute inset-0 bg-indigo-500 rounded-full blur-3xl opacity-30 group-hover:opacity-50 transition-opacity duration-700"
                    >
                    </div>

                    <!-- Decorative Cubes / Shapes -->
                    <div
                        class="absolute inset-0 flex items-center justify-center animate-[spin_20s_linear_infinite]"
                    >
                        <svg
                            class="w-48 h-48 sm:w-64 sm:h-64 text-indigo-500/80 drop-shadow-[0_0_15px_rgba(99,102,241,0.5)]"
                            viewBox="0 0 100 100"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M50 5 L90 25 L90 75 L50 95 L10 75 L10 25 Z"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"></path>
                            <path
                                d="M50 5 L50 45 L90 25 M50 45 L10 25 M50 45 L50 95"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"></path>
                            <path
                                d="M20 40 L50 55 L80 40"
                                stroke="currentColor"
                                stroke-width="1"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="text-purple-400 opacity-50"></path>
                            <circle
                                cx="50"
                                cy="45"
                                r="3"
                                fill="currentColor"
                                class="text-white"></circle>
                        </svg>
                    </div>

                    <!-- Orbiting nodes -->
                    <div
                        class="absolute -inset-8 border border-white/10 rounded-full animate-[spin_15s_linear_infinite_reverse]"
                    >
                        <div
                            class="absolute top-0 left-1/2 w-4 h-4 -translate-x-1/2 -translate-y-1/2 bg-purple-500 rounded-full shadow-[0_0_10px_rgba(168,85,247,0.8)]"
                        >
                        </div>
                    </div>
                    <div
                        class="absolute -inset-16 border border-indigo-500/20 rounded-full animate-[spin_25s_linear_infinite]"
                    >
                        <div
                            class="absolute bottom-0 right-1/4 w-3 h-3 bg-indigo-400 rounded-full shadow-[0_0_10px_rgba(129,140,248,0.8)]"
                        >
                        </div>
                        <div
                            class="absolute top-1/4 left-0 w-2 h-2 bg-indigo-300 rounded-full shadow-[0_0_10px_rgba(165,180,252,0.8)]"
                        >
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
