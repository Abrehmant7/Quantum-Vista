---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact Us - Quantum Vista">
    <section
        class="pt-40 pb-20 bg-gray-950 relative overflow-hidden text-center border-b border-gray-900"
    >
        <div
            class="absolute inset-0 bg-[url('/stardust.png')] opacity-20 pointer-events-none"
        >
        </div>
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 relative z-10">
            <h1
                class="text-5xl md:text-7xl font-extrabold text-white tracking-tight mb-6"
            >
                Let's Start a <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-500"
                    >Conversation</span
                >
            </h1>
            <p class="text-xl text-slate-400 leading-relaxed">
                Ready to accelerate your digital growth? Drop us a message and
                our experts will get back to you immediately.
            </p>
        </div>
    </section>

    <section class="py-24 bg-gray-950 relative">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
                <!-- Contact Info Side -->
                <div>
                    <h2 class="text-3xl font-bold text-white mb-8">
                        Get in Touch
                    </h2>
                    <p class="text-lg text-slate-400 leading-relaxed mb-12">
                        Whether you have a fully scoped project or just the
                        early seed of an idea, we want to hear about it. Use the
                        direct details below or fill out our contact form.
                    </p>
                    <div class="space-y-10">
                        <div class="flex items-start group">
                            <div
                                class="flex-shrink-0 w-14 h-14 bg-gray-900 border border-gray-800 rounded-full flex items-center justify-center text-indigo-400 group-hover:bg-indigo-500/10 group-hover:border-indigo-500/30 transition-colors"
                            >
                                <svg
                                    class="w-6 h-6"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                    ></path><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    ></path></svg
                                >
                            </div>
                            <div class="ml-6">
                                <h4 class="text-white font-bold text-xl mb-2">
                                    Headquarters
                                </h4>
                                <address
                                    class="text-slate-400 leading-relaxed not-italic"
                                >
                                    167-169 Great Portland Street<br />
                                    5th Floor, London<br />
                                    United Kingdom, W1W 5PF
                                </address>
                            </div>
                        </div>

                        <div class="flex items-start group">
                            <div
                                class="flex-shrink-0 w-14 h-14 bg-gray-900 border border-gray-800 rounded-full flex items-center justify-center text-indigo-400 group-hover:bg-indigo-500/10 group-hover:border-indigo-500/30 transition-colors"
                            >
                                <svg
                                    class="w-6 h-6"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    ><path
                                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"></path></svg
                                >
                            </div>
                            <div class="ml-6">
                                <h4 class="text-white font-bold text-xl mb-2">
                                    Direct Line
                                </h4>
                                <p class="text-slate-400">
                                    <a
                                        href="tel:+447403650851"
                                        class="hover:text-white transition-colors text-lg"
                                        >+44 7403 650851</a
                                    >
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start group">
                            <div
                                class="flex-shrink-0 w-14 h-14 bg-gray-900 border border-gray-800 rounded-full flex items-center justify-center text-indigo-400 group-hover:bg-indigo-500/10 group-hover:border-indigo-500/30 transition-colors"
                            >
                                <svg
                                    class="w-6 h-6"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                    ></path></svg
                                >
                            </div>
                            <div class="ml-6">
                                <h4 class="text-white font-bold text-xl mb-2">
                                    Official Email
                                </h4>
                                <p class="text-slate-400">
                                    <a
                                        href="mailto:info@quantumvista.uk"
                                        class="hover:text-white transition-colors text-lg"
                                        >info@quantumvista.uk</a
                                    >
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form Side -->
                <div
                    class="bg-gray-900 border border-gray-800 p-8 sm:p-12 rounded-3xl shadow-2xl relative"
                >
                    <div
                        class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-indigo-500/10 rounded-3xl pointer-events-none"
                    >
                    </div>

                    <form
                        action="https://api.web3forms.com/submit"
                        method="POST"
                        id="contactForm"
                        class="space-y-6 relative z-10"
                    >
                        <div id="formResult" class="hidden"></div>
                        <!-- Web3Forms API Configuration -->
                        <input
                            type="hidden"
                            name="access_key"
                            value="5bd2bcba-5976-43d1-997f-1f7800210117"
                        />
                        <input
                            type="hidden"
                            name="subject"
                            value="New Contact Inquiry from Quantum Vista Website"
                        />

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div>
                                <label
                                    for="name"
                                    class="block text-sm font-medium text-slate-300 mb-2"
                                    >Full Name</label
                                >
                                <input
                                    type="text"
                                    name="name"
                                    id="name"
                                    required
                                    class="w-full bg-gray-950 border border-gray-700 rounded-xl px-5 py-4 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
                                    placeholder="John Doe"
                                />
                            </div>
                            <div>
                                <label
                                    for="email"
                                    class="block text-sm font-medium text-slate-300 mb-2"
                                    >Email Address</label
                                >
                                <input
                                    type="email"
                                    name="email"
                                    id="email"
                                    required
                                    class="w-full bg-gray-950 border border-gray-700 rounded-xl px-5 py-4 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
                                    placeholder="john@example.com"
                                />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div>
                                <label
                                    for="phone"
                                    class="block text-sm font-medium text-slate-300 mb-2"
                                    >Phone Number <span
                                        class="text-slate-500 font-normal"
                                        >(Optional)</span
                                    ></label
                                >
                                <input
                                    type="tel"
                                    name="phone"
                                    id="phone"
                                    class="w-full bg-gray-950 border border-gray-700 rounded-xl px-5 py-4 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
                                    placeholder="+44 0000 000000"
                                />
                            </div>
                            <div>
                                <label
                                    for="company"
                                    class="block text-sm font-medium text-slate-300 mb-2"
                                    >Company <span
                                        class="text-slate-500 font-normal"
                                        >(Optional)</span
                                    ></label
                                >
                                <input
                                    type="text"
                                    name="company"
                                    id="company"
                                    class="w-full bg-gray-950 border border-gray-700 rounded-xl px-5 py-4 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
                                    placeholder="Your Business Ltd."
                                />
                            </div>
                        </div>

                        <div>
                            <label
                                for="message"
                                class="block text-sm font-medium text-slate-300 mb-2"
                                >Project Details</label
                            >
                            <textarea
                                name="message"
                                id="message"
                                rows="5"
                                required
                                class="w-full bg-gray-950 border border-gray-700 rounded-xl px-5 py-4 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all resize-none"
                                placeholder="Tell us about your objectives and technical requirements..."
                            ></textarea>
                        </div>

                        <!-- Web3Forms Honeypot spam protection -->
                        <input
                            type="checkbox"
                            name="botcheck"
                            class="hidden"
                            style="display: none;"
                        />

                        <button
                            type="submit"
                            class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold py-5 rounded-xl shadow-xl hover:shadow-indigo-500/25 transition-all outline-none focus:ring-4 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-gray-900 border border-transparent text-lg"
                        >
                            Send Message
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>
</Layout>

<script>
    const form = document.getElementById("contactForm");
    const result = document.getElementById("formResult");

    if (form && result) {
        form.addEventListener("submit", function (e) {
            e.preventDefault();

            const formData = new FormData(form);
            const object = Object.fromEntries(formData);
            const json = JSON.stringify(object);

            result.classList.remove("hidden");
            result.className =
                "font-medium rounded-lg p-4 mb-6 bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 transition-all";
            result.innerHTML = "Sending message...";

            fetch("https://api.web3forms.com/submit", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    Accept: "application/json",
                },
                body: json,
            })
                .then(async (response) => {
                    let responseJson = await response.json();
                    if (response.status == 200) {
                        result.className =
                            "font-medium rounded-lg p-4 mb-6 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 transition-all";
                        result.innerHTML =
                            "Message sent successfully! We'll be in touch soon.";
                        form.reset();

                        setTimeout(() => {
                            result.classList.add("hidden");
                        }, 5000);
                    } else {
                        console.log(response);
                        result.className =
                            "font-medium rounded-lg p-4 mb-6 bg-red-500/10 border border-red-500/20 text-red-400 transition-all";
                        result.innerHTML =
                            responseJson.message || "An error occurred.";
                    }
                })
                .catch((error) => {
                    console.log(error);
                    result.className =
                        "font-medium rounded-lg p-4 mb-6 bg-red-500/10 border border-red-500/20 text-red-400 transition-all";
                    result.innerHTML =
                        "Something went wrong! Please try again later.";
                });
        });
    }
</script>
