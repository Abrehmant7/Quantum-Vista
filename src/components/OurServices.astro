---
const services = [
    {
        title: "Website Development",
        href: "/services/website-development",
        description:
            "We build fast, scalable, and visually stunning custom websites tailored to convert visitors and provide seamless user experiences.",
        icon: `<svg class="w-8 h-8 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
        color: "from-blue-500 to-cyan-500",
    },
    {
        title: "App Development",
        href: "/services/app-development",
        description:
            "Launch powerful, native or cross-platform mobile applications for iOS and Android that put your business right in your customers' pockets.",
        icon: `<svg class="w-8 h-8 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>`,
        color: "from-indigo-500 to-purple-500",
    },
    {
        title: "Social Media Marketing",
        href: "/services/social-media-marketing",
        description:
            "Grow your brand organically. We craft engaging content, manage your channels, and build a loyal community around your business.",
        icon: `<svg class="w-8 h-8 text-pink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>`,
        color: "from-pink-500 to-rose-500",
    },
    {
        title: "SEO",
        href: "/services/seo",
        description:
            "Dominate search rankings. Our Search Engine Optimization strategies drive high-intent organic traffic directly to your digital storefront.",
        icon: `<svg class="w-8 h-8 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" /></svg>`,
        color: "from-emerald-500 to-green-500",
    },
    {
        title: "Search Engine Marketing",
        href: "/services/sem",
        description:
            "Get immediate visibility. We execute highly targeted paid search and PPC campaigns that maximize your ROI and generate instant leads.",
        icon: `<svg class="w-8 h-8 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" /></svg>`,
        color: "from-orange-500 to-red-500",
    },
    {
        title: "Email Marketing",
        href: "/services/email-marketing",
        description:
            "Nurture leads and drive long-term conversions with automated, highly personalized email campaigns that resonate with your audience.",
        icon: `<svg class="w-8 h-8 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
        color: "from-yellow-400 to-amber-600",
    },
];
---

<section
    class="py-24 bg-gray-950 relative overflow-hidden border-t border-gray-900"
>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center mb-16">
            <h2
                class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl"
            >
                Our <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400 inline-block"
                    >Services</span
                >
            </h2>
            <p class="mt-4 text-xl text-slate-400 max-w-3xl mx-auto">
                Empowering your business with end-to-end digital excellence.
            </p>
        </div>

        <!-- The grid centers the last element if it wraps unevenly using standard tailwind utilities. 
         With 6 items, on lg (3 cols), it perfectly fills 2 rows of 3. -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                services.map((service, index) => (
                    <div
                        class="reveal-on-scroll reveal-zoom rounded-2xl border border-gray-800 bg-gray-900/40 p-8 shadow-lg hover:border-gray-700 hover:bg-gray-800/60 transition-all duration-300 flex flex-col h-full group relative overflow-hidden"
                        style={`--reveal-delay: ${index * 90}ms;`}
                    >
                        <div
                            class={`absolute top-0 right-0 w-32 h-32 bg-gradient-to-br ${service.color} opacity-10 rounded-full blur-3xl transform group-hover:scale-150 transition-transform duration-500`}
                        />
                        <div
                            class="w-14 h-14 rounded-lg bg-gray-800 flex items-center justify-center mb-6 z-10"
                            set:html={service.icon}
                        />
                        <h3 class="text-xl font-bold text-white mb-3 z-10">
                            {service.title}
                        </h3>
                        <p class="text-slate-400 leading-relaxed text-sm flex-grow z-10">
                            {service.description}
                        </p>
                        <div class="mt-8 z-10">
                            <a
                                href={service.href}
                                class="inline-flex items-center text-sm font-semibold text-indigo-400 hover:text-indigo-300 transition-colors"
                            >
                                Know More
                                <span
                                    class="ml-2 group-hover:translate-x-1 transition-transform"
                                    aria-hidden="true"
                                >
                                    &rarr;
                                </span>
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
