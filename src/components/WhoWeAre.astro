---

---

<section class="py-24 bg-gray-950 relative overflow-hidden">
    <!-- Grid Background Overlay -->
    <div
        class="absolute inset-0 bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-30"
    >
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center mb-16">
            <h2
                class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-400 inline-block"
            >
                Who We Are
            </h2>
            <p class="mt-6 text-lg text-slate-300 max-w-3xl mx-auto">
                Quantum Vista bridges the gap between technology and your
                audience. We build the software that powers your business, and
                we market the brand that defines yours.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <!-- Software Card -->
            <div
                class="reveal-on-scroll reveal-from-left rounded-2xl border border-gray-800 bg-gray-900/50 p-8 shadow-xl backdrop-blur-sm relative overflow-hidden group hover:border-indigo-500/50 transition-colors duration-500"
                style="--reveal-delay: 80ms;"
            >
                <div
                    class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-indigo-500 to-blue-500"
                >
                </div>
                <div
                    class="w-14 h-14 rounded-lg bg-indigo-500/10 flex items-center justify-center mb-6"
                >
                    <svg
                        class="w-8 h-8 text-indigo-400"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                    </svg>
                </div>
                <h3 class="text-2xl font-bold text-white mb-4">
                    Custom Software Solutions
                </h3>
                <p class="text-slate-400 leading-relaxed text-sm">
                    We don't believe in one-size-fits-all. Our expert team
                    develops bespoke software specifically tailored to your
                    unique customer needs. From scalable web applications to
                    powerful backend systems, we engineer solutions that drive
                    efficiency, growth, and innovation.
                </p>
            </div>

            <!-- Marketing Card -->
            <div
                class="reveal-on-scroll reveal-from-right rounded-2xl border border-gray-800 bg-gray-900/50 p-8 shadow-xl backdrop-blur-sm relative overflow-hidden group hover:border-purple-500/50 transition-colors duration-500"
                style="--reveal-delay: 180ms;"
            >
                <div
                    class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-purple-500 to-pink-500"
                >
                </div>
                <div
                    class="w-14 h-14 rounded-lg bg-purple-500/10 flex items-center justify-center mb-6"
                >
                    <svg
                        class="w-8 h-8 text-purple-400"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"
                        ></path>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"
                        ></path>
                    </svg>
                </div>
                <h3 class="text-2xl font-bold text-white mb-4">
                    Digital Marketing
                </h3>
                <p class="text-slate-400 leading-relaxed text-sm">
                    Building great software is only half the battle. We market
                    your brand to the world through data-driven organic
                    strategies and highly targeted paid social media campaigns.
                    Let's make sure your message reaches the right audience and
                    converts them into loyal customers.
                </p>
            </div>
        </div>
    </div>
</section>
