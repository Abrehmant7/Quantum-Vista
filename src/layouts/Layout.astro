---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
// Importing the font locally via Fontsource (no external CDNs)
import "@fontsource/jetbrains-mono";

interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="Quantum Vista - Accelerate Your Digital Growth"
		/>
		<meta name="viewport" content="width=device-width" />
		<!-- Utilizing native logo asset explicitly converted for favicon use -->
		<link rel="icon" type="image/png" href="/favicon.png" />

		<title>{title}</title>
	</head>
	<body
		class="bg-gray-950 text-slate-100 font-sans antialiased selection:bg-indigo-500 selection:text-white flex flex-col min-h-screen"
	>
		<Navbar />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
	</body>
</html>
