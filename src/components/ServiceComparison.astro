---
const services = [
    {
        name: "Websites",
        color: "from-blue-500 to-cyan-400",
        deliverables: ["UI design", "Responsive build", "CMS setup", "Technical SEO", "Analytics"],
    },
    {
        name: "Apps",
        color: "from-indigo-500 to-violet-400",
        deliverables: ["Product planning", "UX flows", "Frontend build", "API integration", "Launch support"],
    },
    {
        name: "SEO",
        color: "from-emerald-500 to-teal-400",
        deliverables: ["Keyword research", "On-page setup", "Content plan", "Core Web Vitals", "Ranking reports"],
    },
    {
        name: "Paid Search",
        color: "from-orange-500 to-amber-400",
        deliverables: ["Campaign setup", "Ad copy", "Landing pages", "Conversion tracking", "Optimization"],
    },
    {
        name: "Social",
        color: "from-pink-500 to-rose-400",
        deliverables: ["Content calendar", "Creative direction", "Post design", "Community growth", "Insights"],
    },
    {
        name: "Email",
        color: "from-yellow-400 to-lime-400",
        deliverables: ["List strategy", "Segmentation", "Automation", "A/B testing", "Performance reports"],
    },
];

const deliverableRows = [
    "Strategy",
    "Design",
    "Development",
    "SEO setup",
    "Campaign management",
    "Analytics",
    "Reporting",
];

const coverage: Record<string, string[]> = {
    Websites: ["Strategy", "Design", "Development", "SEO setup", "Analytics", "Reporting"],
    Apps: ["Strategy", "Design", "Development", "Analytics", "Reporting"],
    SEO: ["Strategy", "SEO setup", "Analytics", "Reporting"],
    "Paid Search": ["Strategy", "Design", "Campaign management", "Analytics", "Reporting"],
    Social: ["Strategy", "Design", "Campaign management", "Analytics", "Reporting"],
    Email: ["Strategy", "Design", "Development", "Campaign management", "Analytics", "Reporting"],
};
---

<section class="py-24 bg-gray-950 relative overflow-hidden border-t border-gray-900">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#4f4f4f24_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f24_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:linear-gradient(to_bottom,transparent,#000_20%,#000_80%,transparent)]"></div>
    <div class="absolute inset-x-0 top-1/2 h-px bg-gradient-to-r from-transparent via-indigo-500/30 to-transparent"></div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl mb-14">
            <p class="text-sm font-bold uppercase tracking-widest text-indigo-400 mb-4">
                Service Comparison
            </p>
            <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-5">
                What you get across each growth track.
            </h2>
            <p class="text-lg text-slate-400 leading-relaxed">
                Every engagement is shaped around outcomes, but these are the core deliverables we commonly include when building, launching, and scaling digital products.
            </p>
        </div>

        <div class="rounded-[2rem] border border-gray-800 bg-gray-900/40 overflow-hidden shadow-2xl">
            <div class="grid grid-cols-1 lg:grid-cols-[0.72fr_1.28fr]">
                <div class="p-6 sm:p-8 border-b lg:border-b-0 lg:border-r border-gray-800">
                    <div class="space-y-5">
                        {services.map((service, index) => (
                            <div
                                class="reveal-on-scroll reveal-from-left group relative overflow-hidden rounded-full border border-gray-800 bg-gray-950/70 p-2"
                                style={`--reveal-delay: ${index * 70}ms;`}
                            >
                                <div class={`absolute inset-y-0 left-0 w-24 bg-gradient-to-r ${service.color} opacity-20 blur-xl transition-opacity duration-300 group-hover:opacity-40`}></div>
                                <div class="relative flex items-center gap-4">
                                    <div class={`h-12 w-12 shrink-0 rounded-full bg-gradient-to-br ${service.color}`}></div>
                                    <div class="min-w-0">
                                        <h3 class="font-bold text-white">{service.name}</h3>
                                        <p class="text-xs text-slate-400 truncate">
                                            {service.deliverables.join(" / ")}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <div class="min-w-[760px]">
                        <div class="grid grid-cols-[1.1fr_repeat(6,0.9fr)] border-b border-gray-800 bg-gray-950/70">
                            <div class="px-5 py-5 text-xs font-bold uppercase tracking-widest text-slate-500">
                                Deliverable
                            </div>
                            {services.map((service) => (
                                <div class="px-4 py-5 text-center text-xs font-bold uppercase tracking-widest text-slate-400">
                                    {service.name}
                                </div>
                            ))}
                        </div>

                        {deliverableRows.map((row, rowIndex) => (
                            <div class="comparison-row grid grid-cols-[1.1fr_repeat(6,0.9fr)] border-b border-gray-800 last:border-b-0">
                                <div class="px-5 py-5 text-sm font-bold text-white">
                                    {row}
                                </div>
                                {services.map((service, serviceIndex) => {
                                    const included = coverage[service.name].includes(row);
                                    return (
                                        <div
                                            class="reveal-on-scroll reveal-zoom px-4 py-5 flex items-center justify-center"
                                            style={`--reveal-delay: ${(rowIndex * 55) + (serviceIndex * 25)}ms;`}
                                        >
                                            <span
                                                class:list={[
                                                    "inline-flex h-7 min-w-7 items-center justify-center rounded-full border text-xs font-extrabold transition-transform duration-300",
                                                    included
                                                        ? `bg-gradient-to-br ${service.color} border-transparent text-gray-950 shadow-lg shadow-black/10`
                                                        : "border-gray-800 text-slate-600 bg-gray-950/70",
                                                ]}
                                            >
                                                {included ? "✓" : "—"}
                                            </span>
                                        </div>
                                    );
                                })}
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
