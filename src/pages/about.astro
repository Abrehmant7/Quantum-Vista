---
import Layout from "../layouts/Layout.astro";
import Cta from "../components/Cta.astro";
import { Image } from "astro:assets";
import logoImage from "../assets/quantum vista logo.png";

const projects = [
    {
        name: "Vanguard Hub",
        desc: "Enterprise logistics platform built for high-throughput scaling and automated supply chain routing.",
        label: "Web Dev",
    },
    {
        name: "Bloom Analytics",
        desc: "Custom big-data dashboard providing real-time insights for retail inventory management.",
        label: "Software",
    },
    {
        name: "Zenith App",
        desc: "Cross-platform mobile application utilizing native acceleration, generating 500k+ downloads.",
        label: "App Dev",
    },
    {
        name: "Horizon Push",
        desc: "Multi-layer SEO and PPC campaign resulting in a 300% ROAS within 6 months.",
        label: "Marketing",
    },
    {
        name: "FitTech Engage",
        desc: "Automated email sequence and community scaling on social media netting 40k new subs.",
        label: "Social Media",
    },
    {
        name: "Atlas Portal",
        desc: "Secure B2B client portal integrating directly with legacy corporate ERP systems.",
        label: "Enterprise",
    },
];

const stats = [
    { label: "Founded", value: "Apr 2026" },
    { label: "Projects Delivered", value: "45+" },
    { label: "Team Experts", value: "12" },
    { label: "Client Retention", value: "98%" },
];
---

<Layout title="About Us - Quantum Vista">
    <!-- Section 1: Hero (Company Info) -->
    <section class="pt-40 pb-20 bg-gray-950 relative overflow-hidden">
        <div
            class="absolute inset-0 bg-[url('/stardust.png')] opacity-20 pointer-events-none"
        >
        </div>
        <div
            class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10 text-center"
        >
            <div
                class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-sm font-semibold mb-8"
            >
                <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"
                ></span>
                Established 4 April 2026
            </div>
            <h1
                class="text-5xl md:text-7xl font-extrabold text-white tracking-tight mb-6"
            >
                Architects of the <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-500 inline-block p-1"
                    >Digital Future</span
                >
            </h1>
            <p class="text-xl text-slate-400 max-w-3xl mx-auto leading-relaxed">
                We are Quantum Vista. Born in an era of rapid technological
                acceleration, we engineer top-tier software and construct
                marketing engines that redefine what's possible for modern
                digital businesses.
            </p>
        </div>
    </section>

    <!-- Section 2: Our Vision -->
    <section class="py-24 bg-gray-900 border-y border-gray-800">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div>
                    <h2
                        class="text-3xl sm:text-4xl font-bold text-white mb-6 tracking-tight"
                    >
                        Our <span class="text-indigo-400">Vision</span>
                    </h2>
                    <p class="text-lg text-slate-400 leading-relaxed mb-6">
                        Our vision is simple: to democratize elite digital
                        engineering and marketing. We adamantly believe that
                        every business, regardless of size, deserves access to
                        world-class software infrastructure and highly optimized
                        data-driven growth strategies.
                    </p>
                    <p class="text-lg text-slate-400 leading-relaxed">
                        Since our inception in April 2026, we've relentlessly
                        focused on bleeding-edge technologies and transparent,
                        measurable results. We don't just act as a standard
                        agency; we embed ourselves to function as your dedicated
                        core operating team.
                    </p>
                </div>
                <div class="relative group">
                    <!-- Abstract grid background design -->
                    <div
                        class="absolute inset-0 bg-gradient-to-r from-blue-500 to-indigo-500 translate-x-4 translate-y-4 rounded-2xl opacity-20 group-hover:translate-x-6 group-hover:translate-y-6 transition-transform duration-500"
                    >
                    </div>

                    <!-- Explicitly positioned relative container dropping flex-center -->
                    <div
                        class="rounded-2xl relative z-10 shadow-2xl border border-gray-700 w-full h-[400px] overflow-hidden bg-gray-800"
                    >
                        <!-- Vision Branding Logo Core Layering -->
                        <div
                            class="absolute inset-0 bg-gray-900/40 backdrop-blur-3xl z-10"
                        >
                        </div>
                        <div
                            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-indigo-500 rounded-full blur-[100px] opacity-60 animate-pulse"
                        >
                        </div>
                        <div
                            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-blue-400 rounded-full blur-[80px] opacity-40"
                        >
                        </div>

                        <!-- Absolute Translate Centering to guarantee mathematically perfect rendering -->
                        <Image
                            src={logoImage}
                            alt="Quantum Vista Logo"
                            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[90%] h-[90%] object-contain z-20 hover:scale-[1.03] transition-transform duration-700"
                        />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 3: Successful Projects -->
    <section class="py-24 bg-gray-950">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2
                    class="text-4xl font-extrabold tracking-tight text-white mb-4"
                >
                    Successful Projects
                </h2>
                <p class="text-lg text-slate-400 max-w-2xl mx-auto">
                    A glimpse into the diverse digital solutions we've proudly
                    engineered since our deployment.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    projects.map((proj) => (
                        <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-2xl hover:border-indigo-500/50 hover:bg-gray-800 transition-all duration-300 group cursor-default">
                            <span class="inline-block px-3 py-1 bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-bold uppercase tracking-wider rounded-full mb-5">
                                {proj.label}
                            </span>
                            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors">
                                {proj.name}
                            </h3>
                            <p class="text-slate-400 leading-relaxed">
                                {proj.desc}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Section 4: Stats -->
    <section
        class="py-20 relative overflow-hidden bg-indigo-950 border-t border-indigo-900 border-b"
    >
        <div
            class="absolute inset-0 bg-gradient-to-br from-indigo-900/90 via-[#0f0e2a] to-blue-900/90 mix-blend-multiply"
        >
        </div>
        <!-- Grain overlay -->
        <div
            class="absolute inset-0 bg-[url('/stardust.png')] opacity-10"
        >
        </div>
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
            <div
                class="grid grid-cols-2 md:grid-cols-4 gap-y-12 gap-x-8 text-center divide-x divide-indigo-500/20"
            >
                {
                    stats.map((stat) => (
                        <div class="flex flex-col justify-center px-4 first:border-l-0 border-l border-indigo-500/20">
                            <div class="text-4xl md:text-5xl text-white font-extrabold tracking-tight mb-2 drop-shadow-[0_0_10px_rgba(255,255,255,0.1)]">
                                {stat.value}
                            </div>
                            <div class="text-indigo-300 text-xs sm:text-sm uppercase tracking-widest font-semibold">
                                {stat.label}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <Cta />
</Layout>
