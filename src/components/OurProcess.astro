---
const steps = [
  { num: '01', title: 'Discovery & Strategy', desc: 'Understanding your vision and aligning on digital objectives.' },
  { num: '02', title: 'Design & Architecture', desc: 'Crafting intuitive UI/UX and scalable technical blueprints.' },
  { num: '03', title: 'Development & Execution', desc: 'Building robust software solutions utilizing modern frameworks.' },
  { num: '04', title: 'Growth & Marketing', desc: 'Deploying targeted campaigns to drive traffic and scale.' }
];
---

<section class="py-24 bg-gray-950 relative overflow-hidden border-t border-gray-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-20">
      <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        Our <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-emerald-400 inline-block">Process</span>
      </h2>
      <p class="mt-4 text-xl text-slate-400 max-w-3xl mx-auto">
        A seamless journey from concept to market dominance.
      </p>
    </div>

    <!-- Timeline Wrapper -->
    <div class="relative">
      <!-- Horizontal Connecting Line (Desktop) -->
      <div class="hidden lg:block absolute top-[2.5rem] left-[12.5%] w-[75%] h-0.5 bg-gradient-to-r from-gray-800 via-emerald-800 to-gray-800"></div>
      
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">
        {steps.map((step) => (
          <div class="relative flex flex-col items-center text-center group">
            <!-- Number Badge -->
            <div class="w-20 h-20 rounded-full bg-gray-900 border-2 border-gray-800 flex items-center justify-center text-2xl font-bold text-gray-500 mb-6 group-hover:border-emerald-500 group-hover:text-emerald-400 group-hover:shadow-[0_0_20px_rgba(16,185,129,0.3)] group-hover:-translate-y-2 transition-all duration-300 relative z-10 bg-gray-950">
              {step.num}
            </div>
            
            <!-- Contextual Glow -->
            <div class="absolute top-10 left-1/2 -translate-x-1/2 -translate-y-1/2 w-20 h-20 bg-emerald-500 rounded-full blur-2xl opacity-0 group-hover:opacity-20 transition-opacity duration-300"></div>

            <h3 class="text-xl font-bold text-white mb-3">{step.title}</h3>
            <p class="text-slate-400 leading-relaxed text-sm px-2">
              {step.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
