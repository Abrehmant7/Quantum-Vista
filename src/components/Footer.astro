---
import { Image } from "astro:assets";
import logoImage from "../assets/quantum vista logo.png";

const year = new Date().getFullYear();
---

<footer class="border-t border-gray-800 bg-gray-950 pt-20 pb-10 mt-auto">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      <!-- Brand & Description -->
      <div class="md:col-span-1 flex flex-col items-start pr-4">
        <a href="/" class="flex flex-row items-center gap-3 mb-8 w-max">
          <Image
            src={logoImage}
            alt="Quantum Vista Logo"
            class="h-10 w-auto object-contain block translate-y-px"
          />
          <span
            class="text-2xl font-bold tracking-tight text-white leading-none"
            >Quantum Vista</span
          >
        </a>
        <p class="text-slate-400 text-base leading-relaxed mb-8">
          Accelerating your digital growth through custom software solutions and
          data-driven marketing strategies.
        </p>
        <!-- Social Links (Placeholders) -->
        <div class="flex space-x-5">
          <a
            aria-label="Twitter"
            href="#"
            class="text-slate-400 hover:text-white transition-colors"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
              ></path></svg
            >
          </a>
          <a
            aria-label="LinkedIn"
            href="#"
            class="text-slate-400 hover:text-white transition-colors"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path></svg
            >
          </a>
          <a
            aria-label="Instagram"
            href="#"
            class="text-slate-400 hover:text-white transition-colors"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.98-6.98C23.986 15.668 24 15.259 24 12c0-3.259-.014-3.668-.072-4.948-.2-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
              ></path></svg
            >
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="md:col-span-1 md:ml-auto">
        <h3
          class="text-white font-bold tracking-wider uppercase mb-5 text-base"
        >
          Company
        </h3>
        <ul class="space-y-4">
          <li>
            <a
              href="/"
              class="text-slate-400 hover:text-indigo-400 transition-colors text-base"
              >Home</a>
          </li>
          <li>
            <a
              href="/about"
              class="text-slate-400 hover:text-indigo-400 transition-colors text-base"
              >About Us</a>
          </li>
          <li>
            <a
              href="/services"
              class="text-slate-400 hover:text-indigo-400 transition-colors text-base"
              >Our Services</a>
          </li>
          <li>
            <a
              href="/contact"
              class="text-slate-400 hover:text-indigo-400 transition-colors text-base"
              >Contact Us</a>
          </li>
        </ul>
      </div>

      <!-- Services -->
      <div class="md:col-span-1 md:ml-auto">
        <h3
          class="text-white font-bold tracking-wider uppercase mb-5 text-base"
        >
          Services
        </h3>
        <ul class="space-y-4">
          <li>
            <a
              href="/services"
              class="text-slate-400 hover:text-indigo-400 transition-colors text-base"
              >Web Development</a>
          </li>
          <li>
            <a
              href="/services"
              class="text-slate-400 hover:text-indigo-400 transition-colors text-base"
              >App Development</a>
          </li>
          <li>
            <a
              href="/services"
              class="text-slate-400 hover:text-indigo-400 transition-colors text-base"
              >Digital Marketing</a>
          </li>
          <li>
            <a
              href="/services"
              class="text-slate-400 hover:text-indigo-400 transition-colors text-base"
              >SEO & SEM</a>
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="md:col-span-1 xl:ml-auto">
        <h3
          class="text-white font-bold tracking-wider uppercase mb-5 text-base"
        >
          Contact
        </h3>
        <ul class="space-y-5">
          <li class="flex items-start">
            <svg
              class="h-6 w-6 text-indigo-500 mr-3 mt-0.5 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="text-slate-400 text-base"
              >167-169 Great Portland Street<br />5th Floor, London<br />United
              Kingdom, W1W 5PF</span
            >
          </li>
          <li class="flex items-center">
            <svg
              class="h-6 w-6 text-indigo-500 mr-3 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            <a
              href="tel:+447403650851"
              class="text-slate-400 text-base hover:text-white transition-colors"
              >+44 7403 650851</a
            >
          </li>
          <li class="flex items-center">
            <svg
              class="h-6 w-6 text-indigo-500 mr-3 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <a
              href="mailto:info@quantumvista.uk"
              class="text-slate-400 text-base hover:text-white transition-colors"
              >info@quantumvista.uk</a
            >
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div
      class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center"
    >
      <p class="text-base text-slate-500 mb-4 md:mb-0">
        &copy; {year} Quantum Vista. All rights reserved.
      </p>
      <div class="flex space-x-6 text-base text-slate-500">
        <a href="/privacy" class="hover:text-white transition-colors"
          >Privacy Policy</a
        >
        <a href="/terms" class="hover:text-white transition-colors"
          >Terms of Service</a
        >
      </div>
    </div>
  </div>
</footer>
