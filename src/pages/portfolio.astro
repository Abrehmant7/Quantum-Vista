---
import Layout from "../layouts/Layout.astro";
import Cta from "../components/Cta.astro";

const projects = [
    {
        name: "Trip2Go",
        category: "Travel Agency Platform",
        status: "Live travel website",
        summary:
            "A polished travel agency website built to help customers explore destinations, compare trip options, and start booking conversations quickly.",
        challenge:
            "The travel experience needed to feel trustworthy, easy to browse, and conversion-focused across mobile and desktop.",
        solution:
            "We designed an Astro and Tailwind website with destination-led content, strong enquiry paths, fast page loads, CMS-managed sections, and support-ready service pages.",
        impact: ["Travel-focused CMS", "Fast Astro frontend", "Quote-led journeys"],
        stack: ["Astro", "Tailwind CSS", "Headless CMS", "TypeScript", "Netlify"],
        accent: "from-sky-400 to-cyan-500",
        href: "https://trip2go.co.uk/",
        visual: "travel",
    },
    {
        name: "Travelope",
        category: "Tour & Holiday Website",
        status: "Live travel website",
        summary:
            "A modern travel brand website created for destination discovery, package presentation, and lead generation.",
        challenge:
            "The business needed a refined digital presence that could present travel offers clearly while staying simple for the team to update.",
        solution:
            "We delivered a lightweight Astro build with Tailwind styling, CMS-editable content, structured service sections, and a responsive contact flow.",
        impact: ["CMS-managed offers", "Responsive booking flow", "SEO-ready pages"],
        stack: ["Astro", "Tailwind CSS", "Headless CMS", "JavaScript", "Vercel"],
        accent: "from-emerald-400 to-teal-500",
        href: "https://travelope.uk/",
        visual: "travel",
    },
    {
        name: "Indus Valley Talent",
        category: "Talent & Recruitment Website",
        status: "Live talent platform",
        summary:
            "A refined recruitment website built to present talent services, guide visitors through the brand, and create a polished first impression for candidates and hiring teams.",
        challenge:
            "The platform needed to feel premium, modern, and responsive while using motion carefully to make the experience memorable without slowing visitors down.",
        solution:
            "We developed a Next.js and React frontend with Tailwind CSS styling and GSAP-powered interactions for smooth animated sections, confident page transitions, and a sharper brand experience.",
        impact: ["Motion-led experience", "Talent-focused pages", "Responsive frontend"],
        stack: ["React", "Next.js", "GSAP", "Tailwind CSS"],
        accent: "from-fuchsia-400 to-rose-500",
        href: "https://indusvalleytalent.com/",
        visual: "talent",
    },
    {
        name: "NexaCore CRM",
        category: "Customer Relationship Management",
        status: "SaaS product build",
        summary:
            "A CRM platform for managing leads, sales pipelines, client notes, follow-ups, team activity, and reporting in one workspace.",
        challenge:
            "Sales teams needed a cleaner way to track opportunities, automate reminders, and understand pipeline health without switching between spreadsheets and messaging tools.",
        solution:
            "We built a secure, role-based CRM with Kanban pipelines, activity timelines, customer profiles, email notifications, dashboards, and audit-ready data handling.",
        impact: ["Lead-to-client pipeline", "Role-based access", "Real-time dashboards"],
        stack: ["Next.js", "React", "TypeScript", "Supabase", "PostgreSQL", "Prisma", "Tailwind CSS"],
        accent: "from-indigo-400 to-violet-500",
        href: "#",
        visual: "crm",
    },
    {
        name: "StockPilot",
        category: "Inventory Management App",
        status: "Operations platform",
        summary:
            "An inventory management application for tracking stock levels, purchase orders, suppliers, warehouses, and low-stock alerts.",
        challenge:
            "Operations teams needed accurate stock visibility, faster purchase planning, and fewer manual errors across multiple locations.",
        solution:
            "We engineered a web app with barcode-ready item records, inventory movement logs, threshold alerts, supplier management, analytics, and exportable reports.",
        impact: ["Multi-location stock", "Low-stock alerts", "Supplier reporting"],
        stack: ["React", "Node.js", "Express", "PostgreSQL", "Redis", "Docker", "Tailwind CSS"],
        accent: "from-amber-300 to-orange-500",
        href: "#",
        visual: "inventory",
    },
];

const capabilities = [
    "Strategy and product planning",
    "UI/UX design systems",
    "CMS and content workflows",
    "Custom dashboards",
    "Secure authentication",
    "Analytics and reporting",
    "SEO foundations",
    "Deployment and support",
];
---

<Layout title="Portfolio - Quantum Vista">
    <section class="pt-40 pb-20 bg-gray-950 relative overflow-hidden border-b border-gray-900">
        <div class="absolute inset-0 bg-[url('/stardust.png')] opacity-20 pointer-events-none"></div>
        <div class="absolute -top-36 right-0 w-[34rem] h-[34rem] bg-indigo-500/20 rounded-full blur-[120px]"></div>
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="max-w-4xl">
                <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-sm font-semibold mb-8">
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                    Selected Work
                </div>
                <h1 class="text-5xl md:text-7xl font-extrabold text-white tracking-tight mb-6">
                    Digital products built for <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-500">growth</span>
                </h1>
                <p class="text-xl text-slate-400 leading-relaxed max-w-3xl">
                    From travel agency websites to business operations platforms, our portfolio blends fast frontends, practical CMS workflows, and custom software that helps teams move with clarity.
                </p>
            </div>
        </div>
    </section>

    <section class="py-20 bg-gray-950 border-b border-gray-900">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                {capabilities.map((item, index) => (
                    <div
                        class="reveal-on-scroll reveal-zoom portfolio-chip border border-gray-800 bg-gray-900/50 rounded-xl px-5 py-4 text-sm font-semibold text-slate-300"
                        style={`--reveal-delay: ${index * 65}ms;`}
                    >
                        {item}
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="py-24 bg-gray-950">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-24">
            {projects.map((project, index) => (
                <article class={`portfolio-project grid grid-cols-1 lg:grid-cols-2 gap-12 items-center ${index % 2 === 1 ? "lg:[&>*:first-child]:order-2" : ""}`}>
                    <div
                        class={`portfolio-visual relative reveal-on-scroll ${index % 2 === 1 ? "reveal-from-right" : "reveal-from-left"}`}
                        style={`--reveal-delay: ${index * 80}ms;`}
                    >
                        <div class={`absolute -inset-1 bg-gradient-to-r ${project.accent} opacity-20 blur-2xl rounded-3xl`}></div>
                        <div class="portfolio-frame relative rounded-2xl border border-gray-800 bg-gray-900 overflow-hidden shadow-2xl">
                            <div class={`h-2 bg-gradient-to-r ${project.accent}`}></div>
                            <div class="p-6 sm:p-8">
                                <div class="flex items-center justify-between gap-4 mb-8">
                                    <div>
                                        <p class="text-xs uppercase tracking-widest text-slate-500 font-bold mb-2">{project.category}</p>
                                        <h2 class="text-3xl font-extrabold text-white">{project.name}</h2>
                                    </div>
                                    <span class="shrink-0 rounded-full border border-gray-700 bg-gray-950 px-4 py-2 text-xs font-bold text-slate-300">
                                        {project.status}
                                    </span>
                                </div>

                                {project.visual === "travel" && (
                                    <div class="rounded-xl border border-gray-800 bg-gray-950 p-4">
                                        <div class="aspect-[16/10] rounded-lg bg-gradient-to-br from-sky-900 via-slate-900 to-emerald-900 p-5 flex flex-col justify-between overflow-hidden">
                                            <div class="flex justify-between items-start">
                                                <div class="space-y-2">
                                                    <div class="h-3 w-28 rounded-full bg-white/70"></div>
                                                    <div class="h-8 w-44 rounded-lg bg-white/20"></div>
                                                </div>
                                                <div class="h-10 w-10 rounded-full bg-cyan-300/80"></div>
                                            </div>
                                            <div class="grid grid-cols-3 gap-3">
                                                <div class="h-20 rounded-lg bg-white/20 border border-white/10"></div>
                                                <div class="h-20 rounded-lg bg-white/30 border border-white/10"></div>
                                                <div class="h-20 rounded-lg bg-white/20 border border-white/10"></div>
                                            </div>
                                        </div>
                                    </div>
                                )}

                                {project.visual === "crm" && (
                                    <div class="rounded-xl border border-gray-800 bg-gray-950 p-4">
                                        <div class="aspect-[16/10] rounded-lg bg-slate-950 p-4 grid grid-cols-[0.7fr_1.3fr] gap-4 overflow-hidden">
                                            <div class="space-y-3">
                                                <div class="h-8 rounded bg-indigo-500/30"></div>
                                                <div class="h-24 rounded bg-gray-800"></div>
                                                <div class="h-20 rounded bg-gray-800"></div>
                                            </div>
                                            <div class="grid grid-cols-3 gap-3">
                                                <div class="rounded bg-gray-900 border border-gray-800 p-2 space-y-2">
                                                    <div class="h-2 bg-indigo-400 rounded"></div>
                                                    <div class="h-10 bg-gray-800 rounded"></div>
                                                    <div class="h-10 bg-gray-800 rounded"></div>
                                                </div>
                                                <div class="rounded bg-gray-900 border border-gray-800 p-2 space-y-2">
                                                    <div class="h-2 bg-violet-400 rounded"></div>
                                                    <div class="h-10 bg-gray-800 rounded"></div>
                                                    <div class="h-10 bg-gray-800 rounded"></div>
                                                </div>
                                                <div class="rounded bg-gray-900 border border-gray-800 p-2 space-y-2">
                                                    <div class="h-2 bg-emerald-400 rounded"></div>
                                                    <div class="h-10 bg-gray-800 rounded"></div>
                                                    <div class="h-10 bg-gray-800 rounded"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                )}

                                {project.visual === "talent" && (
                                    <div class="rounded-xl border border-gray-800 bg-gray-950 p-4">
                                        <div class="aspect-[16/10] rounded-lg bg-gradient-to-br from-slate-950 via-fuchsia-950 to-rose-950 p-5 overflow-hidden">
                                            <div class="flex items-center justify-between mb-6">
                                                <div class="space-y-2">
                                                    <div class="h-3 w-32 rounded-full bg-white/70"></div>
                                                    <div class="h-8 w-52 rounded-lg bg-white/20"></div>
                                                </div>
                                                <div class="flex -space-x-3">
                                                    <div class="h-11 w-11 rounded-full border-2 border-slate-950 bg-fuchsia-300"></div>
                                                    <div class="h-11 w-11 rounded-full border-2 border-slate-950 bg-rose-300"></div>
                                                    <div class="h-11 w-11 rounded-full border-2 border-slate-950 bg-indigo-300"></div>
                                                </div>
                                            </div>
                                            <div class="grid grid-cols-[1.1fr_0.9fr] gap-4">
                                                <div class="rounded-xl border border-white/10 bg-white/10 p-4 space-y-3">
                                                    <div class="h-3 w-20 rounded bg-fuchsia-300/80"></div>
                                                    <div class="h-14 rounded-lg bg-white/15"></div>
                                                    <div class="h-14 rounded-lg bg-white/10"></div>
                                                </div>
                                                <div class="rounded-xl border border-white/10 bg-white/10 p-4">
                                                    <div class="grid grid-cols-2 gap-3">
                                                        <div class="h-16 rounded-lg bg-white/15"></div>
                                                        <div class="h-16 rounded-lg bg-white/20"></div>
                                                        <div class="h-16 rounded-lg bg-white/10"></div>
                                                        <div class="h-16 rounded-lg bg-white/15"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                )}

                                {project.visual === "inventory" && (
                                    <div class="rounded-xl border border-gray-800 bg-gray-950 p-4">
                                        <div class="aspect-[16/10] rounded-lg bg-slate-950 p-4 overflow-hidden">
                                            <div class="grid grid-cols-4 gap-3 mb-4">
                                                <div class="h-16 rounded bg-amber-400/20 border border-amber-400/20"></div>
                                                <div class="h-16 rounded bg-emerald-400/20 border border-emerald-400/20"></div>
                                                <div class="h-16 rounded bg-blue-400/20 border border-blue-400/20"></div>
                                                <div class="h-16 rounded bg-rose-400/20 border border-rose-400/20"></div>
                                            </div>
                                            <div class="rounded-lg border border-gray-800 overflow-hidden">
                                                {[1, 2, 3, 4].map(() => (
                                                    <div class="grid grid-cols-4 gap-3 border-b border-gray-800 last:border-b-0 p-3">
                                                        <div class="h-3 rounded bg-gray-700"></div>
                                                        <div class="h-3 rounded bg-gray-800"></div>
                                                        <div class="h-3 rounded bg-gray-800"></div>
                                                        <div class="h-3 rounded bg-orange-400/50"></div>
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                                )}
                            </div>
                        </div>
                    </div>

                    <div
                        class={`reveal-on-scroll ${index % 2 === 1 ? "reveal-from-left" : "reveal-from-right"}`}
                        style={`--reveal-delay: ${index * 80 + 130}ms;`}
                    >
                        <p class="text-sm font-bold uppercase tracking-widest text-indigo-400 mb-4">{project.category}</p>
                        <h3 class="text-3xl sm:text-4xl font-extrabold text-white mb-5">{project.summary}</h3>
                        <div class="space-y-6 text-slate-400 leading-relaxed">
                            <div>
                                <h4 class="text-white font-bold mb-2">Challenge</h4>
                                <p>{project.challenge}</p>
                            </div>
                            <div>
                                <h4 class="text-white font-bold mb-2">Solution</h4>
                                <p>{project.solution}</p>
                            </div>
                        </div>

                        <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-3">
                            {project.impact.map((item, impactIndex) => (
                                <div
                                    class="portfolio-impact rounded-lg border border-gray-800 bg-gray-900/60 px-4 py-3 text-sm font-semibold text-slate-300"
                                    style={`--impact-delay: ${impactIndex * 90}ms;`}
                                >
                                    {item}
                                </div>
                            ))}
                        </div>

                        <div class="mt-8">
                            <h4 class="text-white font-bold mb-3">Technology Stack</h4>
                            <div class="flex flex-wrap gap-2">
                                {project.stack.map((tech) => (
                                    <span class="portfolio-tech rounded-full border border-gray-700 bg-gray-900 px-3 py-1 text-xs font-semibold text-slate-300">
                                        {tech}
                                    </span>
                                ))}
                            </div>
                        </div>

                        {project.href !== "#" && (
                            <a href={project.href} target="_blank" rel="noreferrer" class="inline-flex mt-8 items-center rounded-md bg-indigo-600 px-5 py-3 text-sm font-bold text-white hover:bg-indigo-500 transition-colors">
                                Visit Project
                                <span class="ml-2" aria-hidden="true">&rarr;</span>
                            </a>
                        )}
                    </div>
                </article>
            ))}
        </div>
    </section>

    <section class="py-24 bg-gray-900 border-y border-gray-800">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-12 items-start">
                <div class="reveal-on-scroll reveal-from-left">
                    <p class="text-sm font-bold uppercase tracking-widest text-indigo-400 mb-4">How We Build</p>
                    <h2 class="text-4xl font-extrabold text-white tracking-tight mb-5">Every project is designed around measurable progress.</h2>
                    <p class="text-slate-400 leading-relaxed">
                        We combine product thinking, clean interface design, modern engineering, and practical launch support so each project has a clear path from idea to adoption.
                    </p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    {[
                        ["Discovery", "We map goals, users, offers, workflows, and technical requirements before design begins."],
                        ["Design", "We shape responsive interfaces that feel polished, readable, and easy to act on."],
                        ["Development", "We build with modern frameworks, structured data, reusable components, and performance in mind."],
                        ["Launch", "We test, deploy, optimize, and support the product after it goes live."]
                    ].map(([title, copy], index) => (
                        <div
                            class="reveal-on-scroll reveal-zoom portfolio-build-step rounded-xl border border-gray-800 bg-gray-950/70 p-6"
                            style={`--reveal-delay: ${index * 90}ms;`}
                        >
                            <div class="text-indigo-400 font-extrabold mb-4">0{index + 1}</div>
                            <h3 class="text-xl font-bold text-white mb-3">{title}</h3>
                            <p class="text-sm text-slate-400 leading-relaxed">{copy}</p>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <Cta />
</Layout>

<style>
    .portfolio-chip {
        transition: transform 280ms ease, border-color 280ms ease, background-color 280ms ease;
    }

    .portfolio-chip:hover {
        transform: translateY(-5px);
        border-color: rgba(99, 102, 241, 0.55);
    }

    .portfolio-frame {
        transition: transform 520ms ease, box-shadow 520ms ease, border-color 320ms ease;
    }

    .portfolio-frame::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(115deg, transparent 15%, rgba(255, 255, 255, 0.08) 48%, transparent 72%);
        transform: translateX(-120%);
        transition: transform 900ms ease;
        pointer-events: none;
    }

    .portfolio-project:hover .portfolio-frame {
        transform: translateY(-10px) rotateX(1deg);
        border-color: rgba(129, 140, 248, 0.5);
        box-shadow: 0 32px 80px rgba(15, 23, 42, 0.35);
    }

    .portfolio-project:hover .portfolio-frame::after {
        transform: translateX(120%);
    }

    .portfolio-frame [class*="rounded"] {
        transition: transform 360ms ease, opacity 360ms ease;
    }

    .portfolio-project:hover .portfolio-frame [class*="rounded"]:nth-child(odd) {
        transform: translateY(-3px);
    }

    .portfolio-project:hover .portfolio-frame [class*="rounded"]:nth-child(even) {
        transform: translateY(3px);
    }

    .portfolio-impact {
        animation: impact-rise 620ms ease both;
        animation-delay: var(--impact-delay);
        transition: transform 250ms ease, border-color 250ms ease;
    }

    .portfolio-impact:hover,
    .portfolio-tech:hover,
    .portfolio-build-step:hover {
        transform: translateY(-4px);
        border-color: rgba(99, 102, 241, 0.55);
    }

    .portfolio-tech,
    .portfolio-build-step {
        transition: transform 250ms ease, border-color 250ms ease, background-color 250ms ease;
    }

    @keyframes impact-rise {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .portfolio-impact {
            animation: none;
        }

        .portfolio-project:hover .portfolio-frame,
        .portfolio-project:hover .portfolio-frame::after,
        .portfolio-project:hover .portfolio-frame [class*="rounded"],
        .portfolio-impact:hover,
        .portfolio-tech:hover,
        .portfolio-build-step:hover {
            transform: none;
        }
    }
</style>
